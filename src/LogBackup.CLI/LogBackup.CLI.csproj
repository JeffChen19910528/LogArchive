<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LogBackup.Core\LogBackup.Core.csproj" />
    <ProjectReference Include="..\LogBackup.Infrastructure\LogBackup.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>logbackup</AssemblyName>
    <RootNamespace>LogBackup.CLI</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Cross-compiled, self-contained single-file executables (see scripts/publish.ps1). -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Trimming is off: YamlDotNet and Microsoft.Data.Sqlite rely on reflection/native
         loading patterns that IL trimming can break; single-file + self-contained already
         gets us a standalone executable without needing a smaller trimmed size. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
